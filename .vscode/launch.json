{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Android: Build + Install Debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "args": [
        "-lc",
        "export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 && export PATH=$JAVA_HOME/bin:$PATH && ./gradlew assembleDebug installDebug"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
